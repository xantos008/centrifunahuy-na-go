{
  "events": [
    {
      "kind": "ws_send",
      "body": {
        "connect": {
          "token": "<token:1>"
        },
        "id": 1
      }
    },
    {
      "kind": "ws_recv",
      "body": {
        "connect": {
          "client": "<client:1>",
          "ping": 2,
          "pong": true,
          "version": "<version:1>"
        },
        "id": 1
      }
    },
    {
      "kind": "ws_send",
      "body": {
        "id": 2,
        "subscribe": {
          "channel": "lease:renew-RUN"
        }
      }
    },
    {
      "kind": "ws_recv",
      "body": {
        "id": 2,
        "subscribe": {}
      }
    },
    {
      "kind": "http",
      "text": "POST /api/presence",
      "status": 200,
      "body": {
        "result": {
          "presence": {
            "<client:1>": {
              "chan_info": {
                "source": "sub_refresh"
              },
              "client": "<client:1>",
              "conn_info": {
                "name": "initial"
              },
              "user": "proxy-user"
            }
          }
        }
      }
    },
    {
      "kind": "http",
      "text": "POST /api/publish",
      "status": 200,
      "body": {
        "result": {}
      }
    },
    {
      "kind": "ws_recv",
      "body": {
        "push": {
          "channel": "lease:renew-RUN",
          "pub": {
            "data": "lease-refreshed"
          }
        }
      }
    },
    {
      "kind": "ws_send",
      "body": {
        "id": 3,
        "subscribe": {
          "channel": "lease:expire-RUN"
        }
      }
    },
    {
      "kind": "ws_recv",
      "body": {
        "id": 3,
        "subscribe": {}
      }
    },
    {
      "kind": "ws_recv",
      "body": {
        "push": {
          "channel": "lease:expire-RUN",
          "unsubscribe": {
            "code": 2501,
            "reason": "subscription expired"
          }
        }
      }
    },
    {
      "kind": "http",
      "text": "POST /api/publish",
      "status": 200,
      "body": {
        "result": {}
      }
    },
    {
      "kind": "ws_recv",
      "body": {
        "push": {
          "channel": "lease:renew-RUN",
          "pub": {
            "data": "still-subscribed"
          }
        }
      }
    }
  ]
}
