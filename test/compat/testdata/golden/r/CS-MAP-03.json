{
  "events": [
    {
      "kind": "note",
      "text": "stop node-b"
    },
    {
      "kind": "note",
      "text": "run node-b with configs/r-map-modes"
    },
    {
      "kind": "note",
      "text": "node b"
    },
    {
      "kind": "note",
      "text": "node a"
    },
    {
      "kind": "note",
      "text": "node b"
    },
    {
      "kind": "ws_send",
      "body": {
        "connect": {
          "token": "<token:1>"
        },
        "id": 1
      }
    },
    {
      "kind": "ws_recv",
      "body": {
        "connect": {
          "client": "<client:1>",
          "ping": 25,
          "pong": true,
          "version": "<version:1>"
        },
        "id": 1
      }
    },
    {
      "kind": "ws_send",
      "body": {
        "id": 2,
        "subscribe": {
          "channel": "shortmap:map03-RUN",
          "phase": 2,
          "type": 1
        }
      }
    },
    {
      "kind": "ws_recv",
      "body": {
        "id": 2,
        "subscribe": {
          "type": 1
        }
      }
    },
    {
      "kind": "http",
      "text": "POST /api/map_publish",
      "status": 200,
      "body": {
        "result": {
          "epoch": "<epoch:1>"
        }
      }
    },
    {
      "kind": "ws_recv",
      "body": {
        "push": {
          "channel": "shortmap:map03-RUN",
          "pub": {
            "data": {
              "v": 1
            },
            "key": "item"
          }
        }
      }
    },
    {
      "kind": "ws_send",
      "body": {
        "id": 3,
        "subscribe": {
          "channel": "longmap:map03-RUN",
          "phase": 2,
          "type": 1
        }
      }
    },
    {
      "kind": "ws_recv",
      "body": {
        "id": 3,
        "subscribe": {
          "epoch": "<epoch:2>",
          "recoverable": true,
          "type": 1
        }
      }
    },
    {
      "kind": "http",
      "text": "POST /api/map_publish",
      "status": 200,
      "body": {
        "result": {
          "epoch": "<epoch:2>",
          "offset": 1
        }
      }
    },
    {
      "kind": "ws_recv",
      "body": {
        "push": {
          "channel": "longmap:map03-RUN",
          "pub": {
            "data": {
              "v": 1
            },
            "epoch": "<epoch:2>",
            "key": "item",
            "offset": 1
          }
        }
      }
    },
    {
      "kind": "http",
      "text": "POST /api/map_read_state",
      "status": 200,
      "body": {
        "result": {
          "entries": [
            {
              "data": {
                "v": 1
              },
              "key": "item",
              "time": "<time:1>"
            }
          ]
        }
      }
    },
    {
      "kind": "http",
      "text": "POST /api/map_read_state",
      "status": 200,
      "body": {
        "result": {}
      }
    },
    {
      "kind": "ws_send",
      "body": {
        "connect": {
          "token": "<token:1>"
        },
        "id": 1
      }
    },
    {
      "kind": "ws_recv",
      "body": {
        "connect": {
          "client": "<client:2>",
          "ping": 25,
          "pong": true,
          "version": "<version:1>"
        },
        "id": 1
      }
    },
    {
      "kind": "ws_send",
      "body": {
        "id": 2,
        "subscribe": {
          "channel": "shortmap:map03-RUN",
          "phase": 2,
          "type": 1
        }
      }
    },
    {
      "kind": "ws_recv",
      "body": {
        "id": 2,
        "subscribe": {
          "type": 1
        }
      }
    },
    {
      "kind": "ws_send",
      "body": {
        "id": 3,
        "subscribe": {
          "channel": "longmap:map03-RUN",
          "phase": 2,
          "type": 1
        }
      }
    },
    {
      "kind": "ws_recv",
      "body": {
        "id": 3,
        "subscribe": {
          "epoch": "<epoch:2>",
          "offset": 1,
          "recoverable": true,
          "state": [
            {
              "data": {
                "v": 1
              },
              "key": "item",
              "offset": 1
            }
          ],
          "type": 1
        }
      }
    },
    {
      "kind": "http",
      "text": "POST /api/map_clear",
      "status": 200,
      "body": {
        "result": {}
      }
    },
    {
      "kind": "note",
      "text": "node a"
    },
    {
      "kind": "note",
      "text": "remove node-b copy"
    },
    {
      "kind": "note",
      "text": "start node-b"
    },
    {
      "kind": "note",
      "text": "node b"
    },
    {
      "kind": "note",
      "text": "node a"
    },
    {
      "kind": "note",
      "text": "info: 2 nodes"
    },
    {
      "kind": "note",
      "text": "node b"
    },
    {
      "kind": "note",
      "text": "info: 2 nodes"
    },
    {
      "kind": "note",
      "text": "node a"
    }
  ]
}
